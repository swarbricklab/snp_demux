min_version("7.32.0")

# Path roots as global variables
out_dir = Path(config["outs"]["root"])
logs = Path(config["outs"]["logs"])
# Where the HTML reports are written. Configurable so a dataset can place them
# alongside its other published reports; defaults to keeping them under the
# module's own output root.
report_dir = Path(config["outs"].get("reports", str(out_dir / "report")))


